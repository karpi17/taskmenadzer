<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TaskMenadzer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/neon_blue</item>
        <item name="colorPrimaryVariant">@color/space_background_dark</item>
        <item name="colorOnPrimary">@color/space_background_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="colorSecondaryVariant">@color/neon_pink</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/space_background_dark</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/space_background_dark</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SpaceTitleText">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">@color/neon_blue</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">10</item>
    </style>
</resources>